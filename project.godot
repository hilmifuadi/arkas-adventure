; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Petualangan Arka di Kampung Ninja"
config/description="Game petualangan ninja top-down untuk keluarga: Arka, Bida, Nadiya, dan Farah menyelamatkan Desa Daun."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.png"

[autoload]

Settings="*res://system/core/settings.gd"
GameState="*res://system/core/game_state.gd"
SaveSystem="*res://system/core/save_system.gd"
Audio="*res://system/core/audio_manager.gd"
Scenes="*res://system/core/scene_manager.gd"
Dialogue="*res://system/dialogue/dialogue.gd"
Quests="*res://system/quest/quests.gd"
MathPuzzles="*res://system/puzzle/math_puzzles.gd"

[internationalization]

locale/fallback="id"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/vsync/vsync_mode=0

[file_customization]

folder_colors={
"res://audio/": "yellow",
"res://content/": "green",
"res://system/": "blue",
"res://theme/": "pink"
}

